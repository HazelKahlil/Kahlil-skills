{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kahlil-aesthetic/draft.schema.json",
  "title": "Kahlil Aesthetic asset draft v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "kind", "sources", "evidence", "analysis"],
  "properties": {
    "name": { "type": "string", "minLength": 3, "maxLength": 96 },
    "kind": { "enum": ["image", "screenshot", "url", "content"] },
    "requestedStatus": { "enum": ["complete", "partial"] },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["file", "url", "conversation"] },
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "maxLength": 500 },
          "rights": { "enum": ["owned", "licensed", "public-domain", "unknown", "restricted"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["primary", "supporting", "capture", "derived"] },
          "label": { "type": "string", "maxLength": 500 },
          "derivedFrom": { "type": "string" },
          "captureId": { "type": "string", "format": "uuid" }
        }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["htmlPath", "metadataPath"],
      "properties": { "htmlPath": { "type": "string" }, "metadataPath": { "type": "string" } }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["overall", "tags", "composition", "palette", "typography", "material", "motionInteraction", "reuse", "avoid"],
      "properties": {
        "overall": { "type": "string" }, "tags": { "$ref": "#/$defs/textList" },
        "composition": { "type": "string" }, "spacing": { "type": "string" }, "palette": { "type": "string" },
        "typography": { "type": "string" }, "material": { "type": "string" }, "motionInteraction": { "type": "string" },
        "reuse": { "$ref": "#/$defs/textList" }, "avoid": { "$ref": "#/$defs/textList" }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preferredMode": { "enum": ["adaptive", "material-faithful", "composition-faithful"] },
        "referenceRequired": { "type": "boolean" },
        "referenceEvidenceIds": { "$ref": "#/$defs/textList" },
        "visualDNA": {
          "type": "object", "additionalProperties": false,
          "properties": { "mustPreserve": { "$ref": "#/$defs/textList" }, "mayChange": { "$ref": "#/$defs/textList" }, "mustAvoid": { "$ref": "#/$defs/textList" } }
        }
      }
    }
  },
  "$defs": { "textList": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } } }
}
