{
  "project_name": "<PROJECT_NAME>",
  "squad_name": "<SQUAD_NAME>",
  "role_name_preset": null,
  "project_archetype": "new_project | existing_project | legacy_migration | takeover | temporary_project | incident | multi_repo",
  "execution_topology": "<EXECUTION_TOPOLOGY>",
  "squad_justification": "<SQUAD_JUSTIFICATION>",
  "human_owner": "<HUMAN_OWNER>",
  "issue_prefix": "<ISSUE_PREFIX>",
  "enabled_roles": [
    "captain",
    "worker"
  ],
  "agents": {
    "captain": "<CAPTAIN_NAME>",
    "worker": "<WORKER_NAME>",
    "reviewer": null,
    "analyst": null
  },
  "permissions": {
    "pr_create_bundle": "task_branch + scoped_commit + task_branch_push + open_pr",
    "agents_can_merge": false,
    "agents_can_deploy": false,
    "agents_can_access_sensitive_data": false
  },
  "repos": [
    "<REPO_OR_PROJECT_RESOURCE>"
  ],
  "legacy_policy": "unclear legacy issues stay backlog until audited",
  "context_budget": {
    "comment_limit": 80,
    "rejected_repair_limit": 2
  },
  "failure_recovery_attempts_per_class": 1,
  "coordination": {
    "record_leader_activity": true,
    "issue_metadata_namespace": "squad"
  },
  "usage_budget": {
    "mode": "observe",
    "token_limit": null,
    "action_on_limit": "pause_new_delegation_and_escalate"
  },
  "kill_switch": {
    "cancel_targeted_active_tasks": true,
    "require_zero_active_readback": true,
    "preserve_artifacts": true
  },
  "evolution": {
    "substantive_completed_task_threshold": 3,
    "project_workflow_overlay": "optional"
  },
  "mention_markdown": {
    "captain": "<CAPTAIN_MENTION_MARKDOWN_FROM_ROSTER>",
    "worker": "<WORKER_MENTION_MARKDOWN_FROM_ROSTER>",
    "reviewer": null,
    "analyst": null,
    "human_owner": "<HUMAN_OWNER_MENTION_MARKDOWN_FROM_ROSTER>"
  },
  "installation": "draft | pilot | live | paused"
}
